# agentic-os dashboard server — environment variables
#
# Copy this to `.env` (same directory) and fill in real values. The .env file
# is gitignored. The server loads it at boot via `server/load-env.ts`.
# Shell-exported values (e.g. `export SLACK_BOT_TOKEN=...`) take priority over
# anything set here — that lets per-invocation overrides work without editing.
#
# See standard-env-config.md for the loading convention.

# ── Dashboard ports ──────────────────────────────────────────────────────────
# Three variables, one per hop. `npm run dev` starts two sibling processes and
# each reads its own from the shell first and this file second, so a
# per-invocation override (`PORT=… OS_API_PORT=… OS_WEB_PORT=… npm run dev`)
# beats whatever is set here without editing anything.
#
#   PORT         Fastify API listen port          (server/index.ts, default 5174)
#   OS_API_PORT  the Vite proxy's /api/* target   (vite.config.ts, default 5174)
#   OS_WEB_PORT  the Vite dev-server port         (vite.config.ts, default 5173)
#
# PORT and OS_API_PORT name the same server from opposite ends and must be set
# to the SAME value — one is where the API listens, the other is where the web
# server looks for it. Setting only one produces a dashboard whose every /api
# call 502s.
#
# Two installs side by side: give the second install a disjoint pair, e.g.
#
#   PORT=5184
#   OS_API_PORT=5184
#   OS_WEB_PORT=5183
#
# The web port is strict (vite.config.ts sets strictPort), so a collision fails
# the spawn with EADDRINUSE instead of drifting to a free port and invalidating
# the URL the launcher printed. Pick the next pair and retry.
# PORT=5174
# OS_API_PORT=5174
# OS_WEB_PORT=5173

# ── Slack notifications ──────────────────────────────────────────────────────
# Bot-token mode (preferred): set SLACK_BOT_TOKEN to a Bot User OAuth Token
# (starts with xoxb-). The Slack adapter detects this and routes per-rule via
# chat.postMessage to whatever channel each rule's delivery.slack_channel
# specifies. Required scopes: chat:write (and chat:write.public to post in
# channels the bot hasn't been invited to).
# SLACK_BOT_TOKEN=xoxb-...

# Webhook mode (fallback): set SLACK_WEBHOOK_URL to an Incoming Webhook URL.
# The webhook is bound to ONE channel chosen at app-install time; per-rule
# delivery.slack_channel is ignored in this mode.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# ── GitHub ───────────────────────────────────────────────────────────────────
# Nothing to set here. Server-side GitHub calls (PR-state refresh, review
# threads, head snippets) read GITHUB_TOKEN from mcps/github/.env — the same
# file the github MCP uses, so there is one token source for both. The token is
# cached for the process lifetime, so rotate by editing mcps/github/.env and
# restarting the dashboard.
